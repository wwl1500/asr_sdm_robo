<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematype="xml"?>
<package format="3">
  <name>asr_sdm_guidance_planner</name>
  <version>0.1.0</version>
  <description>Front-end guidance path search library. Provides grid-based A* and a 3D Dubins guidance planner used to generate a geometric guide path.</description>
  <maintainer email="carveyrtrail@163.com">Willianms</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>boost</depend>
  <depend>libpcl-all-dev</depend>
  <depend>asr_sdm_esdf_map</depend>
  <depend>dubins_path_3d</depend>
  <depend>rclcpp</depend>

  <!-- Pulled in transitively by the asr_sdm_esdf_map environment headers. -->
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
